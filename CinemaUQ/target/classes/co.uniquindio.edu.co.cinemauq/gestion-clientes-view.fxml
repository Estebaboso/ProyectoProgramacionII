<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.*?>
<AnchorPane prefHeight="750.0" prefWidth="1106.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.uniquindio.edu.co.cinemauq.controller.GestionClientesController">
<children>
<Label layoutX="25" layoutY="20" style="-fx-font-size:24px; -fx-font-weight:bold;" text="CINEMAUQ - CLIENTES, COMPRAS Y RECARGAS" />
<VBox layoutX="25" layoutY="80" prefWidth="720" spacing="10">
<Label style="-fx-font-size: 17px;" text="CLIENTES REGISTRADOS" underline="true" />
<TextField fx:id="txtBuscarCliente" promptText="Buscar por nombre, ID o correo" />
<Button onAction="#buscarCliente" prefWidth="220" style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-font-weight: bold;" text="Buscar cliente" />
<TableView fx:id="tblClientes" prefHeight="260" prefWidth="1056"><columns><TableColumn fx:id="colId" prefWidth="130" text="Documento" />
<TableColumn fx:id="colNombre" prefWidth="215" text="Nombre" />
<TableColumn fx:id="colCorreo" prefWidth="230" text="Correo" />
<TableColumn fx:id="colTelefono" prefWidth="130" text="Teléfono" /></columns></TableView>
</VBox>
<VBox layoutX="775" layoutY="80" prefWidth="300" spacing="10">
<Label style="-fx-font-size: 17px;" text="RECARGAR TARJETA" underline="true" />
<Label fx:id="lblClienteSeleccionado" text="Cliente: -" wrapText="true" />
<Label fx:id="lblSaldoActual" text="Saldo: $0" />
<TextField fx:id="txtMontoRecarga" promptText="Monto de la recarga" />
<Button onAction="#recargarTarjeta" prefWidth="290" style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-font-weight: bold;" text="Registrar recarga" />
<Label fx:id="lblMensajeRecarga" text="" wrapText="true" />
<Button onAction="#volverMenu" prefWidth="290" style="-fx-background-color: #6c757d; -fx-text-fill: white; -fx-font-weight: bold;" text="Volver al menú" />
</VBox>
<VBox layoutX="25" layoutY="520" prefWidth="1056" spacing="10">
<Label style="-fx-font-size: 17px;" text="COMPRAS REGISTRADAS" underline="true" />
<TableView fx:id="tblCompras" prefHeight="150" prefWidth="1056"><columns><TableColumn fx:id="colIdCompra" prefWidth="160" text="Compra" />
<TableColumn fx:id="colClienteCompra" prefWidth="260" text="Cliente" />
<TableColumn fx:id="colFechaCompra" prefWidth="220" text="Fecha" />
<TableColumn fx:id="colTotalCompra" prefWidth="170" text="Total" />
<TableColumn fx:id="colEstadoCompra" prefWidth="220" text="Estado" /></columns></TableView>
</VBox>
</children>
</AnchorPane>
