<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.*?>
<AnchorPane prefHeight="750.0" prefWidth="1106.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.uniquindio.edu.co.cinemauq.controller.RegistroController">
<children>
<Label layoutX="25" layoutY="20" style="-fx-font-size:24px; -fx-font-weight:bold;" text="CINEMAUQ - REGISTRO DE CLIENTE" />
<VBox layoutX="290" layoutY="95" prefWidth="520" spacing="10">
<Label style="-fx-font-size: 17px;" text="DATOS PERSONALES" underline="true" />
<TextField fx:id="txtNombre" promptText="Nombre completo" />
<TextField fx:id="txtId" promptText="Documento de identidad" />
<TextField fx:id="txtTelefono" promptText="Número de teléfono" />
<TextField fx:id="txtCorreo" promptText="Correo electrónico" />
<PasswordField fx:id="txtContrasena" promptText="Contraseña" />
<PasswordField fx:id="txtConfirmarContrasena" promptText="Confirmar contraseña" />
<Label fx:id="lblMensaje" text="" />
<Button onAction="#registrarCliente" prefWidth="240" style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-font-weight: bold;" text="Registrarme" />
<Button onAction="#volverInicio" prefWidth="240" style="-fx-background-color: #6c757d; -fx-text-fill: white; -fx-font-weight: bold;" text="Volver al inicio" />
</VBox>
</children>
</AnchorPane>
