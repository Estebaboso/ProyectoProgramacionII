<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.*?>
<AnchorPane prefHeight="750.0" prefWidth="1106.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.uniquindio.edu.co.cinemauq.controller.GestionAsientosController">
<children>
<Label layoutX="25" layoutY="20" style="-fx-font-size:24px; -fx-font-weight:bold;" text="CINEMAUQ - GESTIÓN DE ASIENTOS" />
<VBox layoutX="25" layoutY="85" prefWidth="320" spacing="10">
<Label style="-fx-font-size: 17px;" text="SELECCIONAR SALA" underline="true" />
<ComboBox fx:id="cbSala" promptText="Sala" maxWidth="1.7976931348623157E308" />
<Button onAction="#cargarAsientos" prefWidth="300" style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-font-weight: bold;" text="Cargar asientos" />
<TextField fx:id="txtFila" promptText="Fila (ejemplo: A)" />
<TextField fx:id="txtColumna" promptText="Columna (ejemplo: 1)" />
<Button onAction="#agregarAsiento" prefWidth="300" style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-font-weight: bold;" text="Agregar asiento" />
<Button onAction="#eliminarAsiento" prefWidth="300" style="-fx-background-color: #dc3545; -fx-text-fill: white; -fx-font-weight: bold;" text="Eliminar asiento seleccionado" />
<Button onAction="#volverMenu" prefWidth="300" style="-fx-background-color: #6c757d; -fx-text-fill: white; -fx-font-weight: bold;" text="Volver al menú" />
</VBox>
<VBox layoutX="380" layoutY="85" prefWidth="695" spacing="10">
<Label style="-fx-font-size: 17px;" text="ASIENTOS DE LA SALA" underline="true" />
<TableView fx:id="tblAsientos" prefHeight="490" prefWidth="1056"><columns><TableColumn fx:id="colCodigo" prefWidth="210" text="Código" />
<TableColumn fx:id="colFila" prefWidth="175" text="Fila" />
<TableColumn fx:id="colColumna" prefWidth="175" text="Columna" />
<TableColumn fx:id="colEstado" prefWidth="120" text="Estado" /></columns></TableView>
</VBox>
</children>
</AnchorPane>
