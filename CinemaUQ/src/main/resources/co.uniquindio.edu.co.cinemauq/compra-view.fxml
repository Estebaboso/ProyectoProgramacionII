<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.*?>
<AnchorPane prefHeight="750.0" prefWidth="1106.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.uniquindio.edu.co.cinemauq.controller.CompraController">
<children>
<Label layoutX="25" layoutY="20" style="-fx-font-size:24px; -fx-font-weight:bold;" text="CINEMAUQ - REALIZAR COMPRA" />
<VBox layoutX="25" layoutY="85" prefWidth="480" spacing="10">
<Label style="-fx-font-size: 17px;" text="ENTRADAS Y CONFITERÍA" underline="true" />
<Label fx:id="lblResumenEntradas" wrapText="true" text="Entradas seleccionadas: -" />
<ComboBox fx:id="cbProducto" promptText="Producto o combo" maxWidth="1.7976931348623157E308" />
<TextField fx:id="txtCantidad" promptText="Cantidad" />
<Button onAction="#agregarProducto" prefWidth="400" style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-font-weight: bold;" text="Agregar producto o combo" />
<TableView fx:id="tblDetalleCompra" prefHeight="290" prefWidth="1056"><columns><TableColumn fx:id="colDescripcion" prefWidth="220" text="Descripción" />
<TableColumn fx:id="colCantidad" prefWidth="100" text="Cantidad" />
<TableColumn fx:id="colSubtotal" prefWidth="140" text="Subtotal" /></columns></TableView>
</VBox>
<VBox layoutX="575" layoutY="85" prefWidth="495" spacing="10">
<Label style="-fx-font-size: 17px;" text="RESUMEN Y PAGO" underline="true" />
<Label fx:id="lblSubtotal" text="Subtotal: $0" />
<Label fx:id="lblDescuento" text="Descuento: $0" />
<Label fx:id="lblTotal" style="-fx-font-size:19px; -fx-font-weight:bold;" text="Total: $0" />
<ComboBox fx:id="cbPromocion" promptText="Promoción disponible" maxWidth="1.7976931348623157E308" />
<Button onAction="#aplicarPromocion" prefWidth="400" style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-font-weight: bold;" text="Aplicar promoción" />
<Label fx:id="lblSaldoTarjeta" text="Saldo tarjeta: $0" />
<Button onAction="#pagarCompra" prefWidth="400" style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-font-weight: bold;" text="Pagar con tarjeta virtual" />
<Label fx:id="lblMensajePago" text="" wrapText="true" />
<Button onAction="#volverMenu" prefWidth="400" style="-fx-background-color: #6c757d; -fx-text-fill: white; -fx-font-weight: bold;" text="Volver al menú" />
</VBox>
</children>
</AnchorPane>
