<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="750.0" prefWidth="1106.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.uniquindio.edu.co.cinemauq.controller.MisComprasController">
<children>
<Label layoutX="25" layoutY="20" style="-fx-font-size:24px; -fx-font-weight:bold;" text="CINEMAUQ - MIS COMPRAS" />
<VBox layoutX="25" layoutY="85" prefWidth="1056" spacing="10">
<Label style="-fx-font-size: 17px;" text="HISTORIAL DE COMPRAS" underline="true" />
   <VBox prefWidth="900" spacing="10">
   <Label fx:id="lblDetalleCompra" text="Selecciona una compra para ver su información" wrapText="true" />
   <Button onAction="#cancelarCompra" prefWidth="240" style="-fx-background-color: #dc3545; -fx-text-fill: white; -fx-font-weight: bold;" text="Solicitar cancelación" />
   <Button onAction="#actualizarCompras" prefWidth="240" style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-font-weight: bold;" text="Actualizar listado" />
   <Button onAction="#volverMenu" prefWidth="240" style="-fx-background-color: #6c757d; -fx-text-fill: white; -fx-font-weight: bold;" text="Volver al menú" />
   </VBox>
<TableView fx:id="tblMisCompras" prefHeight="390" prefWidth="1056"><columns><TableColumn fx:id="colId" prefWidth="135" text="ID" />
<TableColumn fx:id="colFecha" prefWidth="195" text="Fecha" />
<TableColumn fx:id="colTotal" prefWidth="175" text="Total" />
<TableColumn fx:id="colEstado" prefWidth="180" text="Estado" />
<TableColumn fx:id="colDetalle" prefWidth="345" text="Detalle" /></columns></TableView>
</VBox>
</children>
</AnchorPane>
