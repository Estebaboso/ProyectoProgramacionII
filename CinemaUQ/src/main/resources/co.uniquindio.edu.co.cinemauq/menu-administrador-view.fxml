<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.*?>
<AnchorPane prefHeight="750.0" prefWidth="1106.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.uniquindio.edu.co.cinemauq.controller.MenuAdministradorController">
<children>
<Label layoutX="25" layoutY="20" style="-fx-font-size:24px; -fx-font-weight:bold;" text="CINEMAUQ - MENÚ DEL ADMINISTRADOR" />
<VBox layoutX="320" layoutY="100" prefWidth="460" spacing="10">
<Button onAction="#abrirGestionFunciones" prefWidth="460" style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-font-weight: bold;" text="Gestionar películas, salas y funciones" />
<Button onAction="#abrirGestionAsientos" prefWidth="460" style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-font-weight: bold;" text="Gestionar asientos" />
<Button onAction="#abrirConfiteria" prefWidth="460" style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-font-weight: bold;" text="Gestionar productos, combos y promociones" />
<Button onAction="#abrirGestionClientes" prefWidth="460" style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-font-weight: bold;" text="Clientes, compras y recargas" />
<Button onAction="#abrirReportes" prefWidth="460" style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-font-weight: bold;" text="Reportes exportables" />
<Button onAction="#abrirReportesVisuales" prefWidth="460" style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-font-weight: bold;" text="Reportes visuales y estadísticas" />
<Button onAction="#cerrarSesion" prefWidth="460" style="-fx-background-color: #6c757d; -fx-text-fill: white; -fx-font-weight: bold;" text="Cerrar sesión" />
</VBox>
</children>
</AnchorPane>
