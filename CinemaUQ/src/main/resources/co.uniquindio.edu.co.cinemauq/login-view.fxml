<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" prefHeight="474.0" prefWidth="466.0" spacing="15.0"
      xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="co.uniquindio.edu.co.cinemauq.controller.LoginController">
    <padding>
        <Insets bottom="20.0" left="40.0" right="40.0" top="20.0" />
    </padding>

    <Label alignment="TOP_CENTER" text="Iniciar Sesión">
        <font>
            <Font name="System Bold" size="24.0" />
        </font>
    </Label>

    <TextField fx:id="txtCorreoLogin" promptText="Correo electrónico" />

    <PasswordField fx:id="txtContrasenaLogin" promptText="Contraseña" />

    <Label fx:id="lblMensajeLogin" style="-fx-text-fill: #dc3545;" text="" />

    <Button onAction="#iniciarSesion" prefHeight="30.0" prefWidth="200.0"
            style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-font-weight: bold;"
            text="INGRESAR" />

    <Button onAction="#volverInicio" prefHeight="30.0" prefWidth="200.0"
            style="-fx-background-color: #6c757d; -fx-text-fill: white; -fx-font-weight: bold;"
            text="Volver al Inicio" />
</VBox>